{
  "name": "dinner-planner-typescript",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:init": "node --import tsx scripts/init-db.ts",
    "smoke:drag": "tsx scripts/drag-smoke.ts",
    "smoke:local": "tsx scripts/local-smoke.ts",
    "demo": "mkdir -p .local && npm run db:init && PLANNER_DEMO=1 npm run dev",
    "start": "node scripts/serve.mjs",
    "record:slots": "tsx scripts/slot-videos.ts",
    "icons": "tsx scripts/render-icons.ts",
    "smoke:pwa": "tsx scripts/pwa-smoke.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
