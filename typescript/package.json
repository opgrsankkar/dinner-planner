{
  "name": "dinner-planner-typescript",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "contract": "prisma contract emit",
    "db:init": "prisma db init",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:issue-41": "tsx scripts/issue-41-browser.ts",
    "check:runtime": "node --import tsx scripts/runtime-check.ts",
    "demo": "mkdir -p .local && npm run db:init && npm run dev",
    "start": "node scripts/serve.mjs",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "record:slots": "tsx scripts/slot-videos.ts"
  },
  "dependencies": {
    "@prisma/orm-sqlite": "8.0.0-rc.14",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "motion": "13.4.6",
    "prisma": "8.0.0-rc.19",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "overrides": {
    "prisma": {
      "@prisma/orm-toolchain": "8.0.0-rc.14"
    }
  }
}
